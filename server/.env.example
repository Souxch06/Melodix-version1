# Melodix Backend — exemples de configuration (NE JAMAIS committer de fichier .env réel).
# Copier ce fichier en `.env`, éventuellement adapter. Toutes les valeurs ont des
# défauts raisonnables : le serveur fonctionne SANS aucune variable posée.

# Port d'écoute.
PORT=8787

# Origines autorisées pour CORS, séparées par des virgules.
# En production, lister UNIQUEMENT les domaines de l'app web/preview.
# ('*' accepté en développement uniquement.)
MELODIX_ALLOWED_ORIGINS=*

# Délai réseau par requête vers Spotify/Audius, en millisecondes.
MELODIX_UPSTREAM_TIMEOUT_MS=6000

# Nombre de tentatives supplémentaires sur erreur transitoire (429, 5xx, réseau).
MELODIX_UPSTREAM_RETRIES=2

# Budget de requêtes Spotify par heure (garde anti-abus, technique non officielle).
MELODIX_SPOTIFY_MAX_REQUESTS_PER_HOUR=200

# Durée de vie du cache de recherche, en secondes.
MELODIX_SEARCH_CACHE_TTL_SECONDS=86400

# Durée de vie du cache de métadonnées (track/album/playlist/artist), en secondes.
MELODIX_METADATA_CACHE_TTL_SECONDS=86400

# Hash de la requête GraphQL persistée "searchDesktop".
# Vidéo : la valeur connue est utilisée ; surcharger ici si Spotify la fait tourner.

# Journalisation : info | debug | warn | error.
MELODIX_LOG_LEVEL=info
